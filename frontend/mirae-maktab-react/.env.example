# Backend API root (with or without /api/v1 — client normalizes)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# true = UI can still use mock data where APIs fail (dev only)
VITE_USE_MOCK=false

# Optional game portal origin (if backend does not return launch_url)
VITE_GAME_PORTAL_URL=https://games.mirae.uz
